apiVersion: v1
baseDomain: {{ .BaseDomain }}
metadata:
  name: {{ .Name }}
compute:
- name: worker
  replicas: 0
controlPlane:
  name: master
  replicas: 1
networking:
  networkType: OVNKubernetes
  machineNetwork:
  - cidr: {{ .MachineCIDR }}
  clusterNetwork:
  - cidr: {{ .ClusterCIDR }}
    hostPrefix: 23
  serviceNetwork:
  - {{ .ServiceCIDR }}
platform:
  none: {}
pullSecret: {{ quote .PullSecret }}
sshKey: {{ quote .SSHPublicKey }}
