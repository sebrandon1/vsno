apiVersion: v1
kind: Namespace
metadata:
  name: {{ .LCANamespace }}
  annotations: {workload.openshift.io/allowed: management}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: lifecycle-agent
  namespace: {{ .LCANamespace }}
spec:
  targetNamespaces: [{{ .LCANamespace }}]
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: lifecycle-agent
  namespace: {{ .LCANamespace }}
spec:
  name: lifecycle-agent
  channel: {{ quote .Channel }}
  source: {{ quote .Source }}
  sourceNamespace: {{ quote .SourceNamespace }}
  installPlanApproval: Automatic
