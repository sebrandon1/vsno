apiVersion: v1
kind: ConfigMap
metadata:
  name: dnsmasq
  namespace: {{ .Namespace }}
data:
  dnsmasq.conf: |
    no-resolv
    no-hosts
    keep-in-foreground
    log-queries
    # One file per vSNO, written by vsno create and removed by vsno delete
    # (ConfigMap {{ .GuestsConfigMap }}).
    conf-dir=/etc/vsno-guests,*.conf
    # Everything else goes to the host cluster DNS.
    server={{ .HostDNS }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dnsmasq
  namespace: {{ .Namespace }}
spec:
  replicas: 1
  selector: {matchLabels: {app: dnsmasq}}
  template:
    metadata: {labels: {app: dnsmasq}}
    spec:
      serviceAccountName: vsno
      containers:
      - name: dnsmasq
        image: {{ quote .Images.Base }}
        command:
        - bash
        - -c
        - |
          set -e
          dnf -y -q install dnsmasq
          # dnsmasq reads its config once; restart it when a vSNO is added or removed.
          sum() { cat /etc/vsno/dnsmasq.conf /etc/vsno-guests/*.conf 2>/dev/null | md5sum; }
          while true; do
            cur=$(sum)
            dnsmasq -C /etc/vsno/dnsmasq.conf & pid=$!
            while kill -0 "$pid" 2>/dev/null && [ "$(sum)" = "$cur" ]; do sleep 5; done
            kill "$pid" 2>/dev/null || true
            wait "$pid" || true
          done
        securityContext: {runAsUser: 0}
        ports:
        - {containerPort: 53, protocol: UDP}
        - {containerPort: 53, protocol: TCP}
        readinessProbe: {tcpSocket: {port: 53}, periodSeconds: 5}
        volumeMounts:
        - {name: conf, mountPath: /etc/vsno}
        - {name: guests, mountPath: /etc/vsno-guests}
      volumes:
      - {name: conf, configMap: {name: dnsmasq}}
      - {name: guests, configMap: {name: {{ .GuestsConfigMap }}, optional: true}}
---
apiVersion: v1
kind: Service
metadata:
  name: dnsmasq
  namespace: {{ .Namespace }}
spec:
  selector: {app: dnsmasq}
  ports:
  - {name: dns-udp, port: 53, protocol: UDP}
  - {name: dns-tcp, port: 53, protocol: TCP}
