apiVersion: lvm.topolvm.io/v1alpha1
kind: LVMCluster
metadata:
  name: vsno-lvmcluster
  namespace: openshift-storage
spec:
  storage:
    deviceClasses:
    - name: vg-vsno
      default: true
      fstype: xfs
      deviceSelector:
        paths:
        - {{ quote .DiskByID }}
      nodeSelector:
        nodeSelectorTerms:
        - matchExpressions:
          - key: kubernetes.io/hostname
            operator: In
            values: [{{ quote .Node }}]
      thinPoolConfig:
        name: thin-pool-1
        sizePercent: 90
        overprovisionRatio: 10
